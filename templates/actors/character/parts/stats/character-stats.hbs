<div class="flexrow no-wrap stats">
    <div class="sidebar flex1 pos_relative">
        <div class="attrvertalign">
            <img class="profession-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}"/>
        </div>
    </div>
    <div class="flexrow flex3">
        {{#if (or (isAriaTypeSetting "aria") (isAriaTypeSetting "stars"))}}
        <div class="flex1 layout center carac pos_relative">
            <!-- STATS -->
            {{> "systems/aria/templates/actors/character/parts/stats/character-attributes.hbs"}}
        </div>
        {{/if}}

        {{#if (isEnabled "allowInitiative")}}
         <div class="flex1 layout center hpcol1 pos_relative">
            <!-- HP -->
            {{> "systems/aria/templates/actors/character/parts/stats/character-hp-init.hbs"}}
        </div>
        <div class="flex1 layout center hpcol pos_relative">
            <!-- HP -->
            {{> "systems/aria/templates/actors/character/parts/stats/character-initiative.hbs"}}
        </div>
        {{else}}
        <div class="flex1 layout center hpcol pos_relative">
            <!-- HP -->
            {{> "systems/aria/templates/actors/character/parts/stats/character-hp.hbs"}}
        </div>
        {{/if}}
        <div class="flex1 layout center degatcol pos_relative">
            <!-- ATTAQUES -->
            {{> "systems/aria/templates/actors/character/parts/stats/character-attacks.hbs"}}
        </div>
        
    </div>
</div>

<div class="flexrow no-wrap description_row">
    <div class="flexcol"> 
        <div class="form-header">{{ localize "ARIA.details.description" }}</div>
        {{editor biographyHTML target="system.description" button=true owner=owner editable=editable engine=editorEngine}}
    </div>
</div>

{{#if specialAbilityRolls.hasPanelContent}}
<section class="special-ability-roll-panel" aria-label="{{localize 'ARIA.specialAbilityRoll.title'}}">
    <h3>{{localize "ARIA.specialAbilityRoll.title"}}</h3>
    <p>{{localize "ARIA.specialAbilityRoll.guidance"}}</p>
    {{#each specialAbilityRolls.actions}}
    <div class="form-group">
        <button type="button" class="special-ability-roll" data-roll-id="{{id}}" {{#unless ../specialAbilityRolls.editable}}disabled{{/unless}}>
            {{label}} — {{formula}}
        </button>
        {{#if hasThreshold}}
        <span>{{localize "ARIA.specialAbilityRoll.threshold"}}: {{threshold}}%</span>
        {{/if}}
    </div>
    {{/each}}
    {{#each specialAbilityRolls.notices}}
    <p class="notes">{{localize this}}</p>
    {{/each}}
</section>
{{/if}}